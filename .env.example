# Clerk — create an application at https://dashboard.clerk.com and copy both keys.
# New-instance checklist:
#  - Enable Email + Password (or your chosen strategies) under User & Authentication
#  - Enable Organizations (Settings -> Organizations) — the Members page requires it
#  - Add http://localhost:3000 to allowed origins if you change the port
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk sends users for auth (match the routes in app/)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin
